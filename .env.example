# Copy this file to .env for local use. Never commit .env or a real key.
# The default mock provider is offline and needs no API key.
LEGALCASE_LLM_PROVIDER=mock

# OpenAI-compatible endpoint configuration for optional real generation.
# LLM_API_KEY is intentionally empty here; set it only in your local .env.
LLM_API_KEY=
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your-model-name

# Project-prefixed names are also supported:
LEGALCASE_LLM_API_KEY=
LEGALCASE_LLM_BASE_URL=https://api.example.com/v1
LEGALCASE_LLM_MODEL=your-model-name
LEGALCASE_LLM_TIMEOUT=30
