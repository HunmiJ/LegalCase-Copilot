# Environment and secrets
.env
.env.*
!.env.example

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# IDE and editor temporary files
.idea/
.vscode/
*.swp
*.swo
*.tmp
*~

# OS generated files
.DS_Store
Thumbs.db

# Build, test, and coverage artifacts
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Local query-understanding cache and benchmark per-query records
.cache/

# Runtime case-source cache (never curated corpus)
data/cache/

# V0.7.8 runtime archive is externally managed; keep downloaded and generated
# corpus artifacts out of Git. The README and schema remain tracked.
data/runtime/cases/raw/*
!data/runtime/cases/raw/README.md
data/runtime/cases/manifest.jsonl
data/runtime/cases/collection_plan.json
data/runtime/cases/collection_stats.json
data/runtime/cases/processed/*
!data/runtime/cases/processed/README.md
